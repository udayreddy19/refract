# Public API base (leave empty for same-origin PHP on Hostinger)
NEXT_PUBLIC_API_URL=

# Server-only secrets — never expose in client bundles
API_SECRET=

# Firebase (same project as old Refract / ReconcileX)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Razorpay (public key for checkout; secret stays in PHP secrets.php)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional: Cashfree public hints (secrets in PHP)
NEXT_PUBLIC_CASHFREE_ENVIRONMENT=sandbox
